<Window x:Class="EventGhostDotNet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:EventGhostDotNet"
        Title="EventGhost .NET" Height="760" Width="1180" Loaded="Window_Loaded" Closing="Window_Closing" Closed="Window_Closed"
        MinHeight="600" MinWidth="900"
        Background="#F3F5F8" Foreground="#202938"
        FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#2563EB"/>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#202938"/>
            <Setter Property="BorderBrush" Value="#D7DDE6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ItemIconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="2"/>
        </Style>
        <Style x:Key="EditActionIconButton" TargetType="Button" BasedOn="{StaticResource ItemIconButton}">
            <Setter Property="ToolTip" Value="Modifier l'action"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static local:MacroActionKind.Beep}">
                    <Setter Property="IsEnabled" Value="False"/>
                    <Setter Property="ToolTip" Value="Cette action n'a pas de paramètres à modifier."/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Menu DockPanel.Dock="Top" Background="White">
            <MenuItem Header="_Fichier">
                <MenuItem Header="_Enregistrer" Click="SaveConfiguration_Click"/>
                <MenuItem Header="_Recharger la configuration" Click="ReloadConfiguration_Click"/>
                <Separator/>
                <MenuItem Header="_Quitter" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="_Aide">
                <MenuItem Header="_À propos" Click="About_Click"/>
            </MenuItem>
        </Menu>

        <Border DockPanel.Dock="Top" Background="White" BorderBrush="#E0E5EC" BorderThickness="0,0,0,1" Padding="8">
            <WrapPanel>
                <Button Content="Nouvelle macro" Click="AddMacro_Click"/>
                <Button x:Name="EditMacroButton" Content="Modifier macro" IsEnabled="False" Click="EditMacro_Click"/>
                <Button Content="Supprimer macro" Click="RemoveMacro_Click"/>
                <Button Content="Ajouter action" Click="AddAction_Click"/>
                <Button x:Name="EditActionButton" Content="Modifier action" IsEnabled="False" Click="EditAction_Click"/>
                <Button Content="Supprimer action" Click="RemoveAction_Click"/>
                <Button Content="Exécuter" Background="#2563EB" Foreground="White" BorderBrush="#2563EB" Click="RunMacro_Click"/>
                <Button Content="Déclencher un événement" Click="SimulateEvent_Click"/>
                <Button Content="Arrêter les plugins" Click="StopPlugins_Click"/>
                <Button Content="Enregistrer" Click="SaveConfiguration_Click"/>
            </WrapPanel>
        </Border>

        <StatusBar DockPanel.Dock="Bottom" Background="White" BorderBrush="#E0E5EC" BorderThickness="0,1,0,0">
            <StatusBarItem>
                <TextBlock Text="Moteur prêt — les événements peuvent déclencher les macros associées."/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="ConfigurationPathText" Foreground="#687386"/>
            </StatusBarItem>
        </StatusBar>

        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="220"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Row="0" Grid.Column="0" Background="White" BorderBrush="#E0E5EC" BorderThickness="1" CornerRadius="5" Margin="0,0,8,8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Macros" FontSize="16" FontWeight="SemiBold" Padding="14,12"/>
                    <ListBox x:Name="MacrosList" BorderThickness="0" SelectionChanged="MacrosList_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <EventSetter Event="MouseDoubleClick" Handler="MacroItem_MouseDoubleClick"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="7,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding IsEnabled}" VerticalAlignment="Center" Margin="0,0,8,0"
                                              ToolTip="Activer ou désactiver la macro" AutomationProperties.Name="Macro active"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                        <TextBlock Text="{Binding EventNamesDisplay, StringFormat=Événements : {0}}" TextWrapping="Wrap" FontSize="11" Foreground="#687386" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Style="{StaticResource ItemIconButton}" Content="&#xE70F;"
                                            Click="EditMacroItem_Click" ToolTip="Modifier la macro" AutomationProperties.Name="Modifier la macro"/>
                                    <Button Grid.Column="3" Style="{StaticResource ItemIconButton}" Content="&#xE74D;"
                                            Click="RemoveMacroItem_Click" Foreground="#B42318" ToolTip="Supprimer la macro" AutomationProperties.Name="Supprimer la macro"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Row="0" Grid.Column="1" Background="White" BorderBrush="#E0E5EC" BorderThickness="1" CornerRadius="5" Margin="0,0,0,8" Padding="16">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <TextBlock x:Name="SelectedMacroNameText" Text="Sélectionnez une macro" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock x:Name="SelectedMacroEventText" Text="Choisissez une macro pour consulter ses actions." TextWrapping="Wrap" Foreground="#687386" Margin="0,5,0,0"/>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Séquence d'actions" FontWeight="SemiBold" Margin="0,0,0,7"/>
                    <ListBox x:Name="ActionsList" BorderBrush="#E0E5EC" BorderThickness="1"
                             SelectionChanged="ActionsList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <EventSetter Event="MouseDoubleClick" Handler="ActionItem_MouseDoubleClick"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding IsEnabled}" VerticalAlignment="Center" Margin="8,0,0,0"
                                              ToolTip="Activer ou désactiver l'action" AutomationProperties.Name="Action active"/>
                                    <TextBlock Grid.Column="1" Text="{Binding DisplayName}" TextWrapping="Wrap" Padding="8,7"/>
                                    <Button Grid.Column="2" Style="{StaticResource EditActionIconButton}" Content="&#xE70F;"
                                            Click="EditActionItem_Click" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="Modifier l'action"/>
                                    <Button Grid.Column="3" Style="{StaticResource ItemIconButton}" Content="&#xE74D;"
                                            Click="RemoveActionItem_Click" Foreground="#B42318" ToolTip="Supprimer l'action" AutomationProperties.Name="Supprimer l'action"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Row="1" Grid.ColumnSpan="2" Background="#172033" BorderBrush="#172033" BorderThickness="1" CornerRadius="5" Padding="12">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Journal d'exécution" Foreground="White" FontSize="14" FontWeight="SemiBold" Margin="0,0,12,0"/>
                        <Button Content="Copier le nom de l'événement" Click="CopyEventName_Click"/>
                        <Button Content="Ajouter à la macro sélectionnée" Click="AssignEventName_Click"/>
                    </StackPanel>
                    <ListBox x:Name="LogList" Background="#172033" Foreground="#DDE6F4" BorderThickness="0" FontFamily="Consolas" FontSize="12"/>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
