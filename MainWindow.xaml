<Window x:Class="EventGhostDotNet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:EventGhostDotNet"
        Title="EventGhost .NET" Height="760" Width="1180" Loaded="Window_Loaded" Closing="Window_Closing"
        Closed="Window_Closed"
        MinHeight="600" MinWidth="900"
        Background="#F3F5F8" Foreground="#202938"
        FontFamily="Segoe UI">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Items/StartupSection/StartupSectionTemplate.xaml"/>
                <ResourceDictionary Source="Items/PluginStartup/PluginStartupTemplate.xaml"/>
                <ResourceDictionary Source="Items/MacroGroup/MacroGroupTemplate.xaml"/>
                <ResourceDictionary Source="Items/Macro/MacroTemplate.xaml"/>
                <ResourceDictionary Source="Items/MacroEvent/MacroEventTemplate.xaml"/>
                <ResourceDictionary Source="Items/MacroAction/MacroActionTemplate.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="ItemIconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
                <Setter Property="Width" Value="28"/>
                <Setter Property="Height" Value="28"/>
                <Setter Property="MinHeight" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="2"/>
            </Style>
            <Style x:Key="EditActionIconButton" TargetType="Button" BasedOn="{StaticResource ItemIconButton}">
                <Setter Property="ToolTip" Value="Modifier l'action"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static local:MacroActionKind.Beep}">
                        <Setter Property="IsEnabled" Value="False"/>
                        <Setter Property="ToolTip" Value="Cette action n'a pas de paramètres à modifier."/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style TargetType="TreeViewItem">
                <Style.Resources>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#DBEAFE"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#1D4ED8"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#DBEAFE"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#1D4ED8"/>
                </Style.Resources>
                <Setter Property="IsExpanded" Value="True"/>
                <Setter Property="Padding" Value="4,3"/>
                <Setter Property="Margin" Value="1"/>
                <Setter Property="Background" Value="Transparent"/>
                <EventSetter Event="MouseDoubleClick" Handler="TreeItem_MouseDoubleClick"/>
                <EventSetter Event="Loaded" Handler="TreeItem_Loaded"/>
                <EventSetter Event="Expanded" Handler="TreeItem_Expanded"/>
                <EventSetter Event="Collapsed" Handler="TreeItem_Collapsed"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#F2F6FC"/>
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="#DBEAFE"/>
                        <Setter Property="Foreground" Value="#1D4ED8"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <DataTemplate x:Key="ActionChoiceGroupHeaderTemplate">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#466586"
                           Margin="0,5,0,2"/>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel>
        <Menu DockPanel.Dock="Top" Background="White">
            <MenuItem Header="_Fichier">
                <MenuItem Header="_Enregistrer" Click="SaveConfiguration_Click"/>
                <MenuItem Header="_Recharger la configuration" Click="ReloadConfiguration_Click"/>
                <MenuItem Header="_Préférences de démarrage" Click="StartupPreferences_Click"/>
                <Separator/>
                <MenuItem Header="_Quitter" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="_Aide">
                <MenuItem Header="_À propos" Click="About_Click"/>
            </MenuItem>
        </Menu>

        <Border DockPanel.Dock="Top" Background="White" BorderBrush="#E0E5EC" BorderThickness="1" CornerRadius="10"
                Margin="12,8,12,0" Padding="8">
            <WrapPanel>
                <Button Content="Déclencher un événement" Click="SimulateEvent_Click"/>
                <Button Content="Arrêter les plugins" Click="StopPlugins_Click"/>
                <Button Content="Enregistrer" Click="SaveConfiguration_Click"/>
            </WrapPanel>
        </Border>

        <StatusBar DockPanel.Dock="Bottom" Background="White" BorderBrush="#E0E5EC" BorderThickness="0,1,0,0">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Moteur prêt — les événements peuvent déclencher les macros associées."/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="ConfigurationPathText" Foreground="#687386"/>
            </StatusBarItem>
        </StatusBar>

        <Grid Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#172033" BorderBrush="#172033" BorderThickness="1" CornerRadius="10" Padding="12">
                <DockPanel>
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="Journal d'exécution" Foreground="White" FontSize="14" FontWeight="SemiBold" Margin="0,0,12,0"/>
                        <Button Content="Copier la sélection" Command="ApplicationCommands.Copy"
                                CommandTarget="{Binding ElementName=LogList}" ToolTip="Copier les lignes sélectionnées (Ctrl+C)"/>
                        <Button Content="Effacer le journal" Click="ClearLog_Click"/>
                        <Button Content="Copier le nom de l'événement" Click="CopyEventName_Click"/>
                        <Button Content="Ajouter à la macro sélectionnée" Click="AssignEventName_Click"/>
                    </WrapPanel>
                    <ListBox x:Name="LogList" Background="#172033" Foreground="#DDE6F4" BorderThickness="0" FontFamily="Consolas" FontSize="12"
                             SelectionMode="Extended" ScrollViewer.HorizontalScrollBarVisibility="Auto" Loaded="LogList_Loaded"
                             PreviewMouseLeftButtonDown="LogList_PreviewMouseLeftButtonDown"
                             PreviewMouseLeftButtonUp="LogList_PreviewMouseLeftButtonUp"
                             PreviewMouseMove="LogList_PreviewMouseMove" MouseLeave="LogList_MouseLeave">
                        <ListBox.CommandBindings>
                            <CommandBinding Command="ApplicationCommands.Copy" Executed="CopyLog_Executed" CanExecute="CopyLog_CanExecute"/>
                        </ListBox.CommandBindings>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="7,5"/>
                                <Setter Property="Margin" Value="1"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#DDE6F4"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#2C3B54"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#315D86"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="Transparent"/>

            <Border Grid.Column="2" Background="White" BorderBrush="#E0E5EC" BorderThickness="1" CornerRadius="10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Configuration" FontSize="16" FontWeight="SemiBold" Padding="14,12"/>
                    <TreeView x:Name="ConfigurationTree" BorderThickness="0" SelectedItemChanged="ConfigurationTree_SelectedItemChanged"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ContextMenuOpening="ConfigurationTree_ContextMenuOpening"
                              AllowDrop="True" PreviewMouseLeftButtonDown="ConfigurationTree_PreviewMouseLeftButtonDown"
                              PreviewMouseLeftButtonUp="ConfigurationTree_PreviewMouseLeftButtonUp"
                              PreviewMouseMove="ConfigurationTree_PreviewMouseMove" MouseLeave="ConfigurationTree_MouseLeave"
                              PreviewDragOver="ConfigurationTree_PreviewDragOver"
                              PreviewDragLeave="ConfigurationTree_PreviewDragLeave"
                              PreviewDrop="ConfigurationTree_PreviewDrop">
                        <TreeView.ContextMenu>
                            <ContextMenu/>
                        </TreeView.ContextMenu>
                    </TreeView>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
