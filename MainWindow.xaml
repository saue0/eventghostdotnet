<Window x:Class="EventGhostDotNet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:EventGhostDotNet"
        Title="EventGhost .NET" Height="760" Width="1180" Loaded="Window_Loaded" Closing="Window_Closing" Closed="Window_Closed"
        MinHeight="600" MinWidth="900"
        Background="#F3F5F8" Foreground="#202938"
        FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#2563EB"/>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#202938"/>
            <Setter Property="BorderBrush" Value="#D7DDE6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ItemIconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="2"/>
        </Style>
        <Style x:Key="EditActionIconButton" TargetType="Button" BasedOn="{StaticResource ItemIconButton}">
            <Setter Property="ToolTip" Value="Modifier l'action"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static local:MacroActionKind.Beep}">
                    <Setter Property="IsEnabled" Value="False"/>
                    <Setter Property="ToolTip" Value="Cette action n'a pas de paramètres à modifier."/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="True"/>
            <EventSetter Event="MouseDoubleClick" Handler="TreeItem_MouseDoubleClick"/>
        </Style>
        <HierarchicalDataTemplate DataType="{x:Type local:StartupSection}" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="0,0,8,0"/>
                <Button Content="Ajouter un plugin" Click="AddPluginStartup_Click"
                        ToolTip="Ajouter une configuration de démarrage de plugin"/>
                <Button Content="Ajouter une action" Click="AddStartupAction_Click"
                        ToolTip="Ajouter une action exécutée au démarrage"/>
            </StackPanel>
        </HierarchicalDataTemplate>
        <DataTemplate DataType="{x:Type local:PluginStartupConfiguration}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding DisplayName}" Margin="0,0,8,0"/>
                <Button Style="{StaticResource ItemIconButton}" Content="&#xE70F;"
                        Click="EditPluginStartupItem_Click" IsEnabled="{Binding CanConfigure}"
                        ToolTip="Modifier le démarrage du plugin" AutomationProperties.Name="Modifier le démarrage du plugin"/>
                <Button Style="{StaticResource ItemIconButton}" Content="&#xE74D;"
                        Click="RemovePluginStartupItem_Click" Foreground="#B42318"
                        ToolTip="Supprimer le démarrage du plugin" AutomationProperties.Name="Supprimer le démarrage du plugin"/>
            </StackPanel>
        </DataTemplate>
        <HierarchicalDataTemplate DataType="{x:Type local:MacroDefinition}" ItemsSource="{Binding TreeChildren}">
            <StackPanel Orientation="Horizontal">
                <CheckBox IsChecked="{Binding IsEnabled}" VerticalAlignment="Center" Margin="0,0,8,0"
                          ToolTip="Activer ou désactiver la macro" AutomationProperties.Name="Macro active"/>
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="0,0,8,0"/>
                <Button Style="{StaticResource ItemIconButton}" Content="&#xE70F;"
                        Click="EditMacroItem_Click" ToolTip="Modifier la macro" AutomationProperties.Name="Modifier la macro"/>
                <Button Style="{StaticResource ItemIconButton}" Content="&#xE74D;"
                        Click="RemoveMacroItem_Click" Foreground="#B42318" ToolTip="Supprimer la macro" AutomationProperties.Name="Supprimer la macro"/>
            </StackPanel>
        </HierarchicalDataTemplate>
        <DataTemplate DataType="{x:Type local:MacroEvent}">
            <StackPanel Orientation="Horizontal">
                <CheckBox IsChecked="{Binding IsEnabled}" VerticalAlignment="Center" Margin="0,0,8,0"
                          ToolTip="Activer ou désactiver l'événement" AutomationProperties.Name="Événement actif"/>
                <TextBlock Margin="5,0,8,0" Foreground="#466586" Text="{Binding Name, StringFormat=Événement : {0}}"/>
                <Button Style="{StaticResource ItemIconButton}" Content="&#xE70F;"
                        Click="EditEventItem_Click" ToolTip="Modifier l'événement" AutomationProperties.Name="Modifier l'événement"/>
                <Button Style="{StaticResource ItemIconButton}" Content="&#xE74D;"
                        Click="RemoveEventItem_Click" Foreground="#B42318" ToolTip="Supprimer l'événement" AutomationProperties.Name="Supprimer l'événement"/>
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type local:MacroAction}">
            <StackPanel Orientation="Horizontal">
                <CheckBox IsChecked="{Binding IsEnabled}" VerticalAlignment="Center" Margin="0,0,8,0"
                          ToolTip="Activer ou désactiver l'action" AutomationProperties.Name="Action active"/>
                <TextBlock Text="{Binding DisplayName}" Margin="0,0,8,0"/>
                <Button Style="{StaticResource EditActionIconButton}" Content="&#xE70F;"
                        Click="EditActionItem_Click" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="Modifier l'action"/>
                <Button Style="{StaticResource ItemIconButton}" Content="&#xE74D;"
                        Click="RemoveActionItem_Click" Foreground="#B42318" ToolTip="Supprimer l'action" AutomationProperties.Name="Supprimer l'action"/>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="ActionChoiceGroupHeaderTemplate">
            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#466586"
                       Margin="0,5,0,2"/>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <Menu DockPanel.Dock="Top" Background="White">
            <MenuItem Header="_Fichier">
                <MenuItem Header="_Enregistrer" Click="SaveConfiguration_Click"/>
                <MenuItem Header="_Recharger la configuration" Click="ReloadConfiguration_Click"/>
                <Separator/>
                <MenuItem Header="_Quitter" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="_Aide">
                <MenuItem Header="_À propos" Click="About_Click"/>
            </MenuItem>
        </Menu>

        <Border DockPanel.Dock="Top" Background="White" BorderBrush="#E0E5EC" BorderThickness="0,0,0,1" Padding="8">
            <WrapPanel>
                <Button Content="Nouvelle macro" Click="AddMacro_Click"/>
                <Button x:Name="EditMacroButton" Content="Modifier macro" IsEnabled="False" Click="EditMacro_Click"/>
                <Button Content="Supprimer macro" Click="RemoveMacro_Click"/>
                <Button Content="Ajouter action" Click="AddAction_Click"/>
                <Button x:Name="EditActionButton" Content="Modifier action" IsEnabled="False" Click="EditAction_Click"/>
                <Button Content="Supprimer action" Click="RemoveAction_Click"/>
                <Button x:Name="RunSelectionButton" Content="Exécuter" IsEnabled="False"
                        Background="#2563EB" Foreground="White" BorderBrush="#2563EB" Click="RunMacro_Click"/>
                <Button Content="Déclencher un événement" Click="SimulateEvent_Click"/>
                <Button Content="Arrêter les plugins" Click="StopPlugins_Click"/>
                <Button Content="Enregistrer" Click="SaveConfiguration_Click"/>
            </WrapPanel>
        </Border>

        <StatusBar DockPanel.Dock="Bottom" Background="White" BorderBrush="#E0E5EC" BorderThickness="0,1,0,0">
            <StatusBarItem>
                <TextBlock Text="Moteur prêt — les événements peuvent déclencher les macros associées."/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="ConfigurationPathText" Foreground="#687386"/>
            </StatusBarItem>
        </StatusBar>

        <Grid Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#172033" BorderBrush="#172033" BorderThickness="1" CornerRadius="5" Padding="12">
                <DockPanel>
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="Journal d'exécution" Foreground="White" FontSize="14" FontWeight="SemiBold" Margin="0,0,12,0"/>
                        <Button Content="Copier le nom de l'événement" Click="CopyEventName_Click"/>
                        <Button Content="Ajouter à la macro sélectionnée" Click="AssignEventName_Click"/>
                    </WrapPanel>
                    <ListBox x:Name="LogList" Background="#172033" Foreground="#DDE6F4" BorderThickness="0" FontFamily="Consolas" FontSize="12"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="Transparent"/>

            <Border Grid.Column="2" Background="White" BorderBrush="#E0E5EC" BorderThickness="1" CornerRadius="5">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Configuration" FontSize="16" FontWeight="SemiBold" Padding="14,12"/>
                    <TreeView x:Name="ConfigurationTree" BorderThickness="0" SelectedItemChanged="ConfigurationTree_SelectedItemChanged"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
