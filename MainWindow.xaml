<Window x:Class="EventGhostDotNet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:EventGhostDotNet"
        Title="EventGhost .NET" Height="720" Width="1100" Loaded="Window_Loaded" Closing="Window_Closing"
        Closed="Window_Closed"
        MinHeight="540" MinWidth="800"
        Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
        FontFamily="Segoe UI" FontSize="12" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Items/StartupSection/StartupSectionTemplate.xaml"/>
                <ResourceDictionary Source="Items/PluginStartup/PluginStartupTemplate.xaml"/>
                <ResourceDictionary Source="Items/MacroGroup/MacroGroupTemplate.xaml"/>
                <ResourceDictionary Source="Items/Macro/MacroTemplate.xaml"/>
                <ResourceDictionary Source="Items/MacroEvent/MacroEventTemplate.xaml"/>
                <ResourceDictionary Source="Items/MacroAction/MacroActionTemplate.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="ToolbarButton" TargetType="Button">
                <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="Width" Value="32"/>
                <Setter Property="Height" Value="30"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="1"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource AccentSoftBorderBrush}"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Background" Value="{DynamicResource SelectionBackgroundBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="ConfigurationItemIcon" TargetType="ContentControl">
                <Setter Property="Width" Value="20"/>
                <Setter Property="Height" Value="20"/>
                <Setter Property="Margin" Value="0,0,6,0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ContentControl">
                            <Grid>
                                <TextBlock Text="{TemplateBinding Tag}" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                           Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                                <Border x:Name="DisabledOverlay" Width="12" Height="12" CornerRadius="6"
                                        Background="{DynamicResource ControlBackgroundBrush}" BorderBrush="{DynamicResource ErrorTextBrush}" BorderThickness="1"
                                        HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                        Visibility="Collapsed">
                                    <TextBlock Text="×" FontFamily="Segoe UI" FontSize="10" FontWeight="Bold"
                                               Foreground="{DynamicResource ErrorTextBrush}" HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="DisabledOverlay" Property="Visibility" Value="Visible"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="ActionItemIcon" TargetType="ContentControl" BasedOn="{StaticResource ConfigurationItemIcon}">
                <Setter Property="Tag" Value="&#xE768;"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static local:MacroActionKind.PowerShell}">
                        <Setter Property="Tag" Value="&#xE756;"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static local:MacroActionKind.Plugin}">
                        <Setter Property="Tag" Value="&#xE90F;"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style TargetType="TreeViewItem">
                <Setter Property="IsExpanded" Value="True"/>
                <Setter Property="Padding" Value="4,3"/>
                <Setter Property="Margin" Value="0"/>
                <Setter Property="Background" Value="Transparent"/>
                <EventSetter Event="MouseDoubleClick" Handler="TreeItem_MouseDoubleClick"/>
                <EventSetter Event="Loaded" Handler="TreeItem_Loaded"/>
                <EventSetter Event="Expanded" Handler="TreeItem_Expanded"/>
                <EventSetter Event="Collapsed" Handler="TreeItem_Collapsed"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TreeViewItem">
                            <Grid SnapsToDevicePixels="True">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <local:TreeViewConnector Grid.Column="0" Grid.RowSpan="2" Width="27"
                                                         HorizontalAlignment="Left" Margin="-9,0,0,0"
                                                         HeaderHeight="{Binding ActualHeight, ElementName=HeaderBorder}"
                                                         IsLastSibling="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(local:MainWindow.IsLastSibling)}"
                                                         IsRoot="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(local:MainWindow.IsTreeRoot)}"
                                                         HasChildren="{Binding HasItems, RelativeSource={RelativeSource TemplatedParent}}"
                                                         IsExpanded="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                                         SnapsToDevicePixels="True"/>
                                <ToggleButton x:Name="Expander" Grid.Column="0" Width="14" Height="14"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Background="{DynamicResource ControlBackgroundBrush}" BorderThickness="0" Padding="0" Focusable="False"
                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="ToggleBorder" Width="9" Height="9" Background="{DynamicResource ControlBackgroundBrush}"
                                                    BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" SnapsToDevicePixels="True">
                                                <Grid>
                                                    <TextBlock x:Name="Plus" Text="+" FontFamily="Segoe UI"
                                                               FontSize="8" Foreground="{DynamicResource PrimaryTextBrush}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="Minus" Text="-" FontFamily="Segoe UI"
                                                               FontSize="8" Foreground="{DynamicResource PrimaryTextBrush}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Visibility="Collapsed"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Plus" Property="Visibility" Value="Collapsed"/>
                                                    <Setter TargetName="Minus" Property="Visibility" Value="Visible"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ToggleBorder" Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                                                    <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <Border x:Name="HeaderBorder" Grid.Column="1" Background="{TemplateBinding Background}"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter x:Name="PART_Header" ContentSource="Header"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                </Border>
                                <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Grid.Column="1"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="HasItems" Value="False">
                                    <Setter TargetName="Expander" Property="Visibility" Value="Collapsed"/>
                                </Trigger>
                                <Trigger Property="IsExpanded" Value="False">
                                    <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="HeaderBorder" Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="HeaderBorder" Property="Background" Value="{DynamicResource SelectionBackgroundBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource SelectionTextBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <DataTemplate x:Key="ActionChoiceGroupHeaderTemplate">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource SectionTextBrush}"
                           Margin="0,5,0,2"/>
            </DataTemplate>
            <HierarchicalDataTemplate DataType="{x:Type local:ConfigurationRoot}" ItemsSource="{Binding Children}">
                <StackPanel Orientation="Horizontal">
                    <ContentControl Style="{StaticResource ConfigurationItemIcon}" Tag="&#xE770;"
                                    Foreground="{DynamicResource SectionTextBrush}" AutomationProperties.Name="Configuration"/>
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </HierarchicalDataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel>
        <Menu DockPanel.Dock="Top" Background="{DynamicResource WindowBackgroundBrush}">
            <MenuItem Header="_Fichier">
                <MenuItem Header="_Enregistrer" Click="SaveConfiguration_Click"/>
                <MenuItem Header="_Recharger la configuration" Click="ReloadConfiguration_Click"/>
                <MenuItem Header="Recharger les _plugins" Click="ReloadPlugins_Click"/>
                <MenuItem Header="_Préférences de démarrage" Click="StartupPreferences_Click"/>
                <MenuItem Header="Préférences _PowerShell..." Click="PowerShellPreferences_Click"/>
                <MenuItem Header="Vérifier les _mises à jour..." Click="CheckForUpdates_Click"/>
                <Separator/>
                <MenuItem Header="_Quitter" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="_Édition">
                <MenuItem x:Name="UndoMenuItem" Header="_Annuler" InputGestureText="Ctrl+Z"
                          Click="Undo_Click" IsEnabled="False"/>
                <MenuItem x:Name="RedoMenuItem" Header="_Rétablir" InputGestureText="Ctrl+Y"
                          Click="Redo_Click" IsEnabled="False"/>
                <Separator/>
                <MenuItem x:Name="CutMenuItem" Header="_Couper" InputGestureText="Ctrl+X"
                          Click="CutSelection_Click" IsEnabled="False"/>
                <MenuItem x:Name="CopyMenuItem" Header="_Copier" InputGestureText="Ctrl+C"
                          Click="CopySelection_Click" IsEnabled="False"/>
                <MenuItem x:Name="CopyAsPythonMenuItem" Header="Copier comme script _Python" Click="CopyAsPython_Click"/>
                <MenuItem x:Name="PasteMenuItem" Header="_Coller" InputGestureText="Ctrl+V" Click="PasteSelection_Click"/>
                <Separator/>
                <MenuItem x:Name="DeleteMenuItem" Header="_Supprimer" InputGestureText="Suppr"
                          Click="DeleteSelection_Click" IsEnabled="False"/>
                <Separator/>
                <MenuItem Header="_Chercher..." InputGestureText="Ctrl+F" Click="Find_Click"/>
                <MenuItem Header="Chercher _suivant" InputGestureText="F3" Click="FindNext_Click"/>
            </MenuItem>
            <MenuItem Header="_Affichage">
                <MenuItem x:Name="ToolbarVisibilityMenuItem" Header="Barre d'_outils"
                          IsCheckable="True" IsChecked="True" Click="ToolbarVisibility_Click"/>
                <Separator/>
                <MenuItem Header="_Développer" Click="ExpandSelected_Click"/>
                <MenuItem Header="_Réduire" Click="CollapseSelected_Click"/>
                <MenuItem Header="Développer tous les enfants" Click="ExpandAll_Click"/>
                <MenuItem Header="Réduire tous les enfants" Click="CollapseAll_Click"/>
                <MenuItem Header="Développer l'arbre de configuration" Click="ExpandAll_Click"/>
                <MenuItem Header="Réduire l'arbre de configuration" Click="CollapseAll_Click"/>
                <Separator/>
                <MenuItem x:Name="AutoExpandOnEventMenuItem" Header="Développer automatiquement l'arbre lors d'un événement"
                          IsCheckable="True" IsChecked="True" Click="AutoExpandOnEvent_Click"/>
                <Separator/>
                <MenuItem x:Name="ShowMacrosInLogMenuItem" Header="Journal : afficher les macros"
                          IsCheckable="True" IsChecked="True" Click="LogCategoryFilter_Click"/>
                <MenuItem x:Name="ShowActionsInLogMenuItem" Header="Journal : afficher les actions"
                          IsCheckable="True" IsChecked="True" Click="LogCategoryFilter_Click"/>
                <MenuItem x:Name="ShowDebugLogMenuItem" Header="Log Debug Info"
                          IsCheckable="True" IsChecked="True" Click="ShowDebugLog_Click"/>
                <Separator/>
                <MenuItem x:Name="IndentLogMenuItem" Header="Indenter le journal"
                          IsCheckable="True" IsChecked="False" Click="LogDisplayOption_Click"/>
                <MenuItem x:Name="DateStampLogMenuItem" Header="Horodater le journal"
                          IsCheckable="True" IsChecked="False" Click="LogDisplayOption_Click"/>
                <MenuItem x:Name="ShowLogTimeMenuItem" Header="Journal : afficher l'heure"
                          IsCheckable="True" IsChecked="True" Click="LogDisplayOption_Click"/>
                <Separator/>
                <MenuItem Header="Copier la sélection du journal" Command="ApplicationCommands.Copy"
                          CommandTarget="{Binding ElementName=LogList}"/>
                <MenuItem Header="Effacer le _journal" InputGestureText="Ctrl+L" Click="ClearLog_Click"/>
            </MenuItem>
            <MenuItem Header="_Configuration">
                <MenuItem Header="Ajouter un _groupe..." InputGestureText="Ctrl+Shift+P" Click="AddMacroGroup_Click"/>
                <MenuItem Header="Ajouter un _dossier..." InputGestureText="Ctrl+Shift+N" Click="AddMacroFolder_Click"/>
                <MenuItem Header="Ajouter une macro _commande..." InputGestureText="Ctrl+Shift+M" Click="AddMacro_Click"/>
                <MenuItem Header="Ajouter un _événement..." InputGestureText="Ctrl+Shift+E" Click="AddMacroEvent_Click"/>
                <MenuItem Header="Ajouter une _action..." InputGestureText="Ctrl+Shift+A" Click="AddAction_Click"/>
                <Separator/>
                <MenuItem x:Name="PropertiesMenuItem" Header="Propriétés de l'_élément..."
                          InputGestureText="Entrée" Click="EditSelected_Click"/>
                <MenuItem x:Name="RenameSelectedMenuItem" Header="_Renommer"
                          InputGestureText="F2" Click="RenameSelected_Click"/>
                <MenuItem x:Name="RunSelectedMenuItem" Header="E_xécuter"
                          InputGestureText="F5" Click="RunMacro_Click"/>
                <Separator/>
                <MenuItem x:Name="ToggleSelectedEnabledMenuItem" Header="_Désactivé" InputGestureText="Ctrl+D"
                          IsCheckable="True"
                          Click="ToggleSelectedEnabled_Click"/>
            </MenuItem>
            <MenuItem Header="_Aide">
                <MenuItem Header="_Documentation" Click="ShowDocumentation_Click"/>
                <MenuItem Header="Documentation des _plugins" Click="ShowPluginDocumentation_Click"/>
                <Separator/>
                <MenuItem Header="_À propos" Click="About_Click"/>
            </MenuItem>
        </Menu>

        <ToolBarTray x:Name="MainToolBarTray" DockPanel.Dock="Top" Background="{DynamicResource WindowBackgroundBrush}">
            <ToolBar Background="{DynamicResource WindowBackgroundBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="0,0,0,1">
                <Button Style="{StaticResource ToolbarButton}" Content="&#xE74E;" Click="SaveConfiguration_Click"
                        ToolTip="Enregistrer la configuration" AutomationProperties.Name="Enregistrer la configuration"/>
                <Button Style="{StaticResource ToolbarButton}" Content="&#xE72C;" Click="ReloadConfiguration_Click"
                        ToolTip="Recharger la configuration" AutomationProperties.Name="Recharger la configuration"/>
                <Separator/>
                <Button Style="{StaticResource ToolbarButton}" Content="&#xE768;" Click="RunMacro_Click"
                        ToolTip="Exécuter la sélection" AutomationProperties.Name="Exécuter la sélection"/>
                <Button Style="{StaticResource ToolbarButton}" Content="&#xE945;" Click="SimulateEvent_Click"
                        ToolTip="Déclencher un événement" AutomationProperties.Name="Déclencher un événement"/>
                <Separator/>
                <Button Style="{StaticResource ToolbarButton}" Content="&#xE71A;" Click="StopPlugins_Click"
                        ToolTip="Arrêter les plugins" AutomationProperties.Name="Arrêter les plugins"/>
                <Button Style="{StaticResource ToolbarButton}" Content="&#xE74D;" Click="ClearLog_Click"
                        ToolTip="Effacer le journal" AutomationProperties.Name="Effacer le journal"/>
            </ToolBar>
        </ToolBarTray>

        <StatusBar DockPanel.Dock="Bottom" Background="{DynamicResource WindowBackgroundBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="0,1,0,0">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Moteur prêt — les événements peuvent déclencher les macros associées."/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="ConfigurationPathText" Foreground="{DynamicResource SecondaryTextBrush}"/>
            </StatusBarItem>
        </StatusBar>

        <Grid Margin="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="11*"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="9*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#172033" BorderBrush="#172033" BorderThickness="1">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#172033" BorderBrush="#2C3B54" BorderThickness="0,0,0,1"
                            Padding="7,5">
                        <DockPanel LastChildFill="False">
                            <TextBlock Text="Journal" FontWeight="SemiBold" Foreground="White"
                                       DockPanel.Dock="Left" Margin="0,0,8,0"/>
                            <Button Content="Copier l'événement" Click="CopyEventName_Click" Padding="5,2"
                                    ToolTip="Copier le nom de l'événement sélectionné"/>
                            <Button Content="Rejouer l'événement" Click="ReplayEvent_Click" Padding="5,2"
                                    Margin="4,0,0,0" ToolTip="Rejouer l'événement sélectionné avec son payload"/>
                            <Button Content="Ajouter à la macro" Click="AssignEventName_Click" Padding="5,2"
                                    Margin="4,0,0,0" ToolTip="Ajouter l'événement sélectionné à la macro"/>
                            <Button Content="Copier" Command="ApplicationCommands.Copy"
                                    CommandTarget="{Binding ElementName=LogList}" Padding="5,2" Margin="4,0,0,0"
                                    ToolTip="Copier les lignes sélectionnées (Ctrl+C)"/>
                        </DockPanel>
                    </Border>
                    <Border DockPanel.Dock="Top" Background="#172033" BorderBrush="#2C3B54" BorderThickness="0,0,0,1"
                            Padding="7,4">
                        <WrapPanel>
                        <TextBlock Text="Niveaux :" Foreground="White" Margin="0,0,8,0"/>
                        <CheckBox x:Name="LogDebugFilter" Content="Debug" IsChecked="True" Foreground="LightGray"
                                  Margin="0,0,10,0" Checked="LogFilter_Changed" Unchecked="LogFilter_Changed"/>
                        <CheckBox x:Name="LogInformationFilter" Content="Information" IsChecked="True" Foreground="LightSkyBlue"
                                  Margin="0,0,10,0" Checked="LogFilter_Changed" Unchecked="LogFilter_Changed"/>
                        <CheckBox x:Name="LogWarningFilter" Content="Avertissement" IsChecked="True" Foreground="Orange"
                                  Margin="0,0,10,0" Checked="LogFilter_Changed" Unchecked="LogFilter_Changed"/>
                        <CheckBox x:Name="LogErrorFilter" Content="Erreur" IsChecked="True" Foreground="Salmon"
                                  Margin="0,0,10,0" Checked="LogFilter_Changed" Unchecked="LogFilter_Changed"/>
                        </WrapPanel>
                    </Border>
                    <ListBox x:Name="LogList" Background="#172033" Foreground="#DDE6F4" BorderThickness="0"
                             FontFamily="Consolas" FontSize="12"
                             SelectionMode="Extended" ScrollViewer.HorizontalScrollBarVisibility="Auto" Loaded="LogList_Loaded"
                             PreviewMouseLeftButtonDown="LogList_PreviewMouseLeftButtonDown"
                             PreviewMouseLeftButtonUp="LogList_PreviewMouseLeftButtonUp"
                             PreviewMouseMove="LogList_PreviewMouseMove" MouseLeave="LogList_MouseLeave">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <ContentPresenter Content="{Binding Display}" AutomationProperties.Name="{Binding Text}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.CommandBindings>
                            <CommandBinding Command="ApplicationCommands.Copy" Executed="CopyLog_Executed" CanExecute="CopyLog_CanExecute"/>
                        </ListBox.CommandBindings>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="7,5"/>
                                <Setter Property="Margin" Value="1"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#DDE6F4"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#2C3B54"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#315D86"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="{DynamicResource ControlBorderBrush}"
                          ShowsPreview="False"/>

            <Border Grid.Column="2" Background="{DynamicResource ControlBackgroundBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{DynamicResource HoverBackgroundBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="0,0,0,1"
                            Padding="7,5">
                        <TextBlock Text="Configuration" FontWeight="SemiBold"/>
                    </Border>
                    <TreeView x:Name="ConfigurationTree" Background="{DynamicResource ControlBackgroundBrush}" BorderThickness="0"
                              SelectedItemChanged="ConfigurationTree_SelectedItemChanged"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ContextMenuOpening="ConfigurationTree_ContextMenuOpening"
                              AllowDrop="True" PreviewMouseLeftButtonDown="ConfigurationTree_PreviewMouseLeftButtonDown"
                              PreviewMouseLeftButtonUp="ConfigurationTree_PreviewMouseLeftButtonUp"
                              PreviewMouseMove="ConfigurationTree_PreviewMouseMove" MouseLeave="ConfigurationTree_MouseLeave"
                              PreviewDragOver="ConfigurationTree_PreviewDragOver"
                              PreviewDragLeave="ConfigurationTree_PreviewDragLeave"
                              PreviewDrop="ConfigurationTree_PreviewDrop">
                        <TreeView.ContextMenu>
                            <ContextMenu/>
                        </TreeView.ContextMenu>
                    </TreeView>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
