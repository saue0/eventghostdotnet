<ResourceDictionary x:Class="EventGhostDotNet.Items.MacroAction.MacroActionTemplate"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:EventGhostDotNet"
                    xmlns:core="clr-namespace:EventGhostDotNet;assembly=EventGhostDotNet.Core">
    <DataTemplate DataType="{x:Type core:MacroAction}">
        <StackPanel Orientation="Horizontal">
            <ContentControl Style="{DynamicResource ActionItemIcon}"
                            IsEnabled="{Binding IsEnabled}" Foreground="{DynamicResource SectionTextBrush}"
                            AutomationProperties.Name="État de l'action"/>
            <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"/>
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
