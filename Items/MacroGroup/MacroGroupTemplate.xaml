<ResourceDictionary x:Class="EventGhostDotNet.Items.MacroGroup.MacroGroupTemplate"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:EventGhostDotNet">
    <HierarchicalDataTemplate DataType="{x:Type local:MacroGroup}" ItemsSource="{Binding Macros}">
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="0,0,8,0"/>
            <Button Style="{DynamicResource ItemIconButton}" Content="&#xE70F;"
                    Click="RenameMacroGroupItem_Click" ToolTip="Renommer le groupe"
                    AutomationProperties.Name="Renommer le groupe"/>
            <Button Style="{DynamicResource ItemIconButton}" Content="&#xE74D;"
                    Click="RemoveMacroGroupItem_Click" Foreground="#B42318"
                    ToolTip="Supprimer le groupe" AutomationProperties.Name="Supprimer le groupe"/>
        </StackPanel>
    </HierarchicalDataTemplate>
</ResourceDictionary>
