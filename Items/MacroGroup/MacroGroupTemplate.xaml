<ResourceDictionary x:Class="EventGhostDotNet.Items.MacroGroup.MacroGroupTemplate"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:EventGhostDotNet">
    <HierarchicalDataTemplate DataType="{x:Type local:MacroGroup}" ItemsSource="{Binding TreeChildren}">
        <StackPanel Orientation="Horizontal">
            <ContentControl Style="{DynamicResource ConfigurationItemIcon}" Tag="&#xE8B7;"
                            IsEnabled="{Binding IsEnabled}" Foreground="{DynamicResource WarningTextBrush}"
                            AutomationProperties.Name="État du groupe"/>
            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </StackPanel>
    </HierarchicalDataTemplate>
</ResourceDictionary>
