<ResourceDictionary x:Class="EventGhostDotNet.Items.StartupSection.StartupSectionTemplate"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:EventGhostDotNet"
                    xmlns:core="clr-namespace:EventGhostDotNet;assembly=EventGhostDotNet.Core">
    <local:TreeChildrenConverter x:Key="TreeChildrenConverter"/>
    <HierarchicalDataTemplate DataType="{x:Type core:StartupSection}"
                              ItemsSource="{Binding Converter={StaticResource TreeChildrenConverter}}">
        <StackPanel Orientation="Horizontal">
            <ContentControl Style="{DynamicResource ConfigurationItemIcon}" Tag="&#xE80F;"
                            Foreground="{DynamicResource SectionTextBrush}" AutomationProperties.Name="Démarrage"/>
            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </StackPanel>
    </HierarchicalDataTemplate>
</ResourceDictionary>
