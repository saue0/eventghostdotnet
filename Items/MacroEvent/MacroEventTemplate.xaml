<ResourceDictionary x:Class="EventGhostDotNet.Items.MacroEvent.MacroEventTemplate"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:EventGhostDotNet">
    <DataTemplate DataType="{x:Type local:MacroEvent}">
        <StackPanel Orientation="Horizontal">
            <CheckBox IsChecked="{Binding IsEnabled}" VerticalAlignment="Center" Margin="0,0,8,0"
                      ToolTip="Activer ou désactiver l'événement" AutomationProperties.Name="Événement actif"/>
            <TextBlock Margin="5,0,8,0" Foreground="#466586" Text="{Binding Name, StringFormat=Événement : {0}}"/>
            <Button Style="{DynamicResource ItemIconButton}" Content="&#xE70F;"
                    Click="EditEventItem_Click" ToolTip="Modifier l'événement" AutomationProperties.Name="Modifier l'événement"/>
            <Button Style="{DynamicResource ItemIconButton}" Content="&#xE74D;"
                    Click="RemoveEventItem_Click" Foreground="#B42318" ToolTip="Supprimer l'événement" AutomationProperties.Name="Supprimer l'événement"/>
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
