<ResourceDictionary x:Class="EventGhostDotNet.Items.MacroEvent.MacroEventTemplate"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:EventGhostDotNet">
    <DataTemplate DataType="{x:Type local:MacroEvent}">
        <StackPanel Orientation="Horizontal">
            <ContentControl Style="{DynamicResource ConfigurationItemIcon}" Tag="&#xE945;"
                            IsEnabled="{Binding IsEnabled}" Foreground="{DynamicResource WarningTextBrush}"
                            AutomationProperties.Name="État de l'événement"/>
            <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource SectionTextBrush}"
                       Text="{Binding Name, StringFormat=Événement : {0}}"/>
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
