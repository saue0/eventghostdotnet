<ResourceDictionary x:Class="EventGhostDotNet.Items.PluginStartup.PluginStartupTemplate"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:EventGhostDotNet">
    <DataTemplate DataType="{x:Type local:PluginStartupConfiguration}">
        <StackPanel Orientation="Horizontal">
            <ContentControl Style="{DynamicResource ConfigurationItemIcon}" Tag="&#xEA86;"
                            IsEnabled="{Binding IsEnabled}" Foreground="{DynamicResource SectionTextBrush}"
                            AutomationProperties.Name="État du démarrage du plugin"/>
            <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"/>
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
