<ResourceDictionary x:Class="EventGhostDotNet.Items.Macro.MacroTemplate"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:EventGhostDotNet">
    <HierarchicalDataTemplate DataType="{x:Type local:MacroDefinition}" ItemsSource="{Binding TreeChildren}">
        <StackPanel Orientation="Horizontal">
            <ContentControl Style="{DynamicResource ConfigurationItemIcon}" Tag="&#xE713;"
                            IsEnabled="{Binding IsEnabled}" Foreground="#2F6F9F"
                            AutomationProperties.Name="État de la macro"/>
            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </StackPanel>
    </HierarchicalDataTemplate>
</ResourceDictionary>
