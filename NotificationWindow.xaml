<Window x:Class="EventGhostDotNet.NotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:emoji="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf"
        Title="EventGhost"
        Width="360"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Cursor="Hand">
    <Border Margin="10"
            Background="White"
            BorderBrush="#D7DDE6"
            BorderThickness="1"
            CornerRadius="10"
            Padding="14,12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.22"/>
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Image Width="26"
                   Height="26"
                   Margin="0,1,11,0"
                   VerticalAlignment="Top"
                   Source="Assets/EventGhostDotNet.ico"/>
            <StackPanel Grid.Column="1">
                <emoji:TextBlock x:Name="TitleText"
                                 FontWeight="SemiBold"
                                 TextTrimming="CharacterEllipsis"
                                 Foreground="#202938"/>
                <emoji:TextBlock x:Name="MessageText"
                                 Margin="0,3,0,0"
                                 MaxHeight="140"
                                 TextWrapping="Wrap"
                                 TextTrimming="CharacterEllipsis"
                                 Foreground="#475467"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
