<Window x:Class="EventGhostDotNet.NotificationHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:emoji="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf"
        Title="Historique des notifications"
        Width="480"
        Height="420"
        MinWidth="360"
        MinHeight="260"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="#F7F9FC">
    <DockPanel Margin="14">
        <TextBlock DockPanel.Dock="Top"
                   Margin="0,0,0,10"
                   TextWrapping="Wrap"
                   Foreground="#475467"
                   Text="Notifications de cette session. Cliquez sur une entrée pour afficher EventGhost."/>
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button Content="Fermer"
                    IsCancel="True"
                    MinWidth="90"
                    Padding="10,4"
                    Click="Close_Click"/>
        </StackPanel>
        <ListBox x:Name="HistoryList"
                 Background="White"
                 BorderBrush="#D7DDE6"
                 HorizontalContentAlignment="Stretch"
                 PreviewMouseLeftButtonUp="HistoryList_PreviewMouseLeftButtonUp">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="4,6">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right"
                                       Margin="8,0,0,0"
                                       FontSize="11"
                                       Foreground="#98A2B3"
                                       Text="{Binding Time}"/>
                            <emoji:TextBlock FontWeight="SemiBold"
                                             Foreground="#202938"
                                             TextTrimming="CharacterEllipsis"
                                             Text="{Binding Title}"/>
                        </DockPanel>
                        <emoji:TextBlock Margin="0,2,0,0"
                                         MaxHeight="80"
                                         TextWrapping="Wrap"
                                         Foreground="#475467"
                                         Text="{Binding Message}"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
