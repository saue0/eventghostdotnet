<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">$(NETCoreSdkRuntimeIdentifier)</RuntimeIdentifier>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <WebView2EnableCsWinRTProjection>false</WebView2EnableCsWinRTProjection>
    <ApplicationIcon>Assets\EventGhostDotNet.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\EventGhostDotNet.ico" />
    <Content Include="Assets\EventGhostDotNet.ico" CopyToOutputDirectory="PreserveNewest" />
    <None Remove="Plugins\**\bin\**;Plugins\**\obj\**;PluginContracts\**\bin\**;PluginContracts\**\obj\**" />
    <None Update="README.md;Plugins\CREER_UN_PLUGIN.md;Plugins\*\README.md"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="Always" ExcludeFromSingleFile="true" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.7.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3719.77" />
    <PackageReference Include="Markdig" Version="0.41.3" />
    <Compile Remove="Plugins\**\*.cs;PluginContracts\**\*.cs" />
    <ProjectReference Include="PluginContracts\PluginContracts.csproj" GlobalPropertiesToRemove="PublishDir" />
    <ProjectReference Include="Plugins\Display\Display.csproj" ReferenceOutputAssembly="false" GlobalPropertiesToRemove="PublishDir" />
    <ProjectReference Include="Plugins\Logitech\Logitech.csproj" ReferenceOutputAssembly="false" GlobalPropertiesToRemove="PublishDir" />
    <ProjectReference Include="Plugins\SystemTrayMenu\SystemTrayMenu.csproj" ReferenceOutputAssembly="false" GlobalPropertiesToRemove="PublishDir" />
    <ProjectReference Include="Plugins\Wallpaper\Wallpaper.csproj" ReferenceOutputAssembly="false" GlobalPropertiesToRemove="PublishDir" />
    <ProjectReference Include="Plugins\Scheduler\Scheduler.csproj" ReferenceOutputAssembly="false" GlobalPropertiesToRemove="PublishDir" />
    <ProjectReference Include="Plugins\FileWatcher\FileWatcher.csproj" ReferenceOutputAssembly="false" GlobalPropertiesToRemove="PublishDir" />
    <ProjectReference Include="Plugins\ProcessWatcher\ProcessWatcher.csproj" ReferenceOutputAssembly="false" GlobalPropertiesToRemove="PublishDir" />
  </ItemGroup>

  <Target Name="CopyBuiltInPlugins" AfterTargets="Build">
    <MSBuild Projects="Plugins\Display\Display.csproj;Plugins\Logitech\Logitech.csproj;Plugins\SystemTrayMenu\SystemTrayMenu.csproj;Plugins\Wallpaper\Wallpaper.csproj;Plugins\Scheduler\Scheduler.csproj;Plugins\FileWatcher\FileWatcher.csproj;Plugins\ProcessWatcher\ProcessWatcher.csproj" Targets="GetTargetPath" RemoveProperties="RuntimeIdentifier">
      <Output TaskParameter="TargetOutputs" ItemName="BuiltInPluginAssemblies" />
    </MSBuild>
    <Copy SourceFiles="@(BuiltInPluginAssemblies)"
          DestinationFiles="@(BuiltInPluginAssemblies->'$(OutDir)Plugins\%(Filename)\%(Filename)%(Extension)')" />
    <Copy SourceFiles="@(BuiltInPluginAssemblies->'%(RootDir)%(Directory)%(Filename).deps.json')"
          DestinationFiles="@(BuiltInPluginAssemblies->'$(OutDir)Plugins\%(Filename)\%(Filename).deps.json')" />
  </Target>

  <Target Name="PublishBuiltInPlugins" AfterTargets="Publish">
    <Copy SourceFiles="$(OutDir)Plugins\Display\Display.dll;$(OutDir)Plugins\Display\Display.deps.json"
          DestinationFolder="$(PublishDir)Plugins\Display" />
    <Copy SourceFiles="$(OutDir)Plugins\Logitech\Logitech.dll;$(OutDir)Plugins\Logitech\Logitech.deps.json"
          DestinationFolder="$(PublishDir)Plugins\Logitech" />
    <Copy SourceFiles="$(OutDir)Plugins\SystemTrayMenu\SystemTrayMenu.dll;$(OutDir)Plugins\SystemTrayMenu\SystemTrayMenu.deps.json"
          DestinationFolder="$(PublishDir)Plugins\SystemTrayMenu" />
    <Copy SourceFiles="$(OutDir)Plugins\Wallpaper\Wallpaper.dll;$(OutDir)Plugins\Wallpaper\Wallpaper.deps.json"
          DestinationFolder="$(PublishDir)Plugins\Wallpaper" />
    <Copy SourceFiles="$(OutDir)Plugins\Scheduler\Scheduler.dll;$(OutDir)Plugins\Scheduler\Scheduler.deps.json"
          DestinationFolder="$(PublishDir)Plugins\Scheduler" />
    <Copy SourceFiles="$(OutDir)Plugins\FileWatcher\FileWatcher.dll;$(OutDir)Plugins\FileWatcher\FileWatcher.deps.json"
          DestinationFolder="$(PublishDir)Plugins\FileWatcher" />
    <Copy SourceFiles="$(OutDir)Plugins\ProcessWatcher\ProcessWatcher.dll;$(OutDir)Plugins\ProcessWatcher\ProcessWatcher.deps.json"
          DestinationFolder="$(PublishDir)Plugins\ProcessWatcher" />
  </Target>

</Project>
