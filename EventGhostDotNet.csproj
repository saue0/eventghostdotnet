<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">$(NETCoreSdkRuntimeIdentifier)</RuntimeIdentifier>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\EventGhostDotNet.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\EventGhostDotNet.ico" />
    <Content Include="Assets\EventGhostDotNet.ico" CopyToOutputDirectory="PreserveNewest" />
    <None Remove="Plugins\**\bin\**;Plugins\**\obj\**;PluginContracts\**\bin\**;PluginContracts\**\obj\**;Core\**\bin\**;Core\**\obj\**;Tests\**\bin\**;Tests\**\obj\**" />
    <None Update="README.md;Items\README.md;Plugins\CREER_UN_PLUGIN.md;Plugins\*\README.md"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="Always" ExcludeFromSingleFile="true" />
  </ItemGroup>

  <ItemGroup>
    <BuiltInPluginProject Include="Plugins\Display\Display.csproj;Plugins\Logitech\Logitech.csproj;Plugins\SystemTrayMenu\SystemTrayMenu.csproj;Plugins\Wallpaper\Wallpaper.csproj;Plugins\Scheduler\Scheduler.csproj;Plugins\FileWatcher\FileWatcher.csproj;Plugins\ProcessWatcher\ProcessWatcher.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <PackageReference Include="Emoji.Wpf" Version="0.3.4" />
    <PackageReference Include="Markdig" Version="0.41.3" />
    <PackageReference Include="TextMateSharp" Version="2.0.5" />
    <PackageReference Include="TextMateSharp.Grammars" Version="2.0.5" />
    <Compile Remove="Plugins\**\*.cs;PluginContracts\**\*.cs;Core\**\*.cs;Tests\**\*.cs" />
    <ProjectReference Include="Core\EventGhostDotNet.Core.csproj" GlobalPropertiesToRemove="PublishDir" />
    <ProjectReference Include="PluginContracts\PluginContracts.csproj" GlobalPropertiesToRemove="PublishDir" />
    <ProjectReference Include="@(BuiltInPluginProject)" ReferenceOutputAssembly="false" GlobalPropertiesToRemove="PublishDir" />
  </ItemGroup>

  <Target Name="CopyBuiltInPlugins" AfterTargets="Build">
    <MSBuild Projects="@(BuiltInPluginProject)" Targets="GetTargetPath" RemoveProperties="RuntimeIdentifier">
      <Output TaskParameter="TargetOutputs" ItemName="BuiltInPluginAssemblies" />
    </MSBuild>
    <Copy SourceFiles="@(BuiltInPluginAssemblies)"
          DestinationFiles="@(BuiltInPluginAssemblies->'$(OutDir)Plugins\%(Filename)\%(Filename)%(Extension)')" />
    <Copy SourceFiles="@(BuiltInPluginAssemblies->'%(RootDir)%(Directory)%(Filename).deps.json')"
          DestinationFiles="@(BuiltInPluginAssemblies->'$(OutDir)Plugins\%(Filename)\%(Filename).deps.json')" />
    <ItemGroup>
      <BuiltInPluginManifestLine Include="@(BuiltInPluginAssemblies->'Plugins\%(Filename)\%(Filename)%(Extension)')" />
    </ItemGroup>
    <WriteLinesToFile File="$(OutDir)Plugins\plugins.manifest" Lines="@(BuiltInPluginManifestLine)" Overwrite="true" />
  </Target>

  <Target Name="PublishBuiltInPlugins" AfterTargets="Publish">
    <MSBuild Projects="@(BuiltInPluginProject)" Targets="GetTargetPath"
             Properties="Configuration=$(Configuration)"
             RemoveProperties="RuntimeIdentifier;OutDir;PublishDir">
      <Output TaskParameter="TargetOutputs" ItemName="PublishedPluginAssembly" />
    </MSBuild>
    <Copy SourceFiles="@(PublishedPluginAssembly)"
          DestinationFolder="$(PublishDir)Plugins\%(Filename)" />
    <Copy SourceFiles="@(PublishedPluginAssembly->'%(RootDir)%(Directory)%(Filename).deps.json')"
          DestinationFolder="$(PublishDir)Plugins\%(Filename)" />
    <ItemGroup>
      <PublishedPluginManifestLine Include="@(PublishedPluginAssembly->'%(Filename)\%(Filename)%(Extension)')" />
    </ItemGroup>
    <WriteLinesToFile File="$(PublishDir)Plugins\plugins.manifest"
                      Lines="Plugins\Display\Display.dll;Plugins\Logitech\Logitech.dll;Plugins\SystemTrayMenu\SystemTrayMenu.dll;Plugins\Wallpaper\Wallpaper.dll;Plugins\Scheduler\Scheduler.dll;Plugins\FileWatcher\FileWatcher.dll;Plugins\ProcessWatcher\ProcessWatcher.dll"
                      Overwrite="true" />
  </Target>

</Project>
